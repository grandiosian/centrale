         "cond": {
          "a": "s:telecommande",
          "cmp": "=",
          "b": 1
         }
        },
        {
         "op": "set",
         "target": "gyrophare",
         "value": 1
        },
        {
         "op": "set",
         "target": "moteur",
         "value": 1
        },
        {
